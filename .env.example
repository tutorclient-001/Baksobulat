# ==========================================
# BANK SOAL PDF - ENVIRONMENT VARIABLES
# ==========================================

# 1. Server & Environment
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# 2. Authentication Secret (Wajib min 32 karakter di Production)
# Generate random secret string: openssl rand -base64 32
AUTH_SECRET="masukkan_minimal_32_karakter_jwt_secret_acak_anda_disini"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 3. Database Neon PostgreSQL
# Dapatkan connection string dari console Neon.tech
DATABASE_URL="postgresql://username:password@ep-sample-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 4. Google Drive Storage
# Buat Google Cloud Service Account dan berikan akses editor ke Google Drive Folder
GOOGLE_SERVICE_ACCOUNT_EMAIL="bank-soal-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1a2b3c4d5e6f7g8h9i0j_folder_id"
STORAGE_PROVIDER="google-drive"
MAX_FILE_SIZE_MB=25

# 5. Default Seed Credentials (Digunakan saat menjalankan 'npm run db:seed')
SEED_ADMIN_EMAIL="admin@banksoal.sch.id"
SEED_ADMIN_PASSWORD="Admin#2026!"
SEED_USER_EMAIL="guru@banksoal.sch.id"
SEED_USER_PASSWORD="Tutor#2026!"
